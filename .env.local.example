# Daily2Odds — Phase 1 Required Variables

# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?connection_limit=1&pool_timeout=20"

# Your deployed site URL (no trailing slash)
NEXT_PUBLIC_URL="https://your-project.vercel.app"

# Strong random string — used for admin API auth
ADMIN_SECRET="change-this-to-a-strong-random-secret"

# Your Telegram channel link (not bot)
# Example: https://t.me/+R8nltTAosLRmODNl  or  https://t.me/yourchannel
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/YOUR_CHANNEL"

# ── Phase 2 only (bot — not needed for Phase 1) ──────────
# TELEGRAM_BOT_TOKEN="..."
# ADMIN_TELEGRAM_CHAT_ID="..."
